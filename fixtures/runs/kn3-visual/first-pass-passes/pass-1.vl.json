{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bound by the renderer to result retention_by_arm. Two bars with their shares written beside them: a layered text mark on a field the bars already show. Grey everywhere except the arm the Claim is about.",
  "data": { "name": "result" },
  "encoding": {
    "y": { "field": "arm", "type": "nominal", "title": null, "sort": ["checklist", "control"] },
    "x": { "field": "retained_7d_rate", "type": "quantitative", "title": null, "axis": null, "scale": { "domain": [0, 0.5] } }
  },
  "layer": [
    {
      "mark": { "type": "bar" },
      "encoding": { "color": { "field": "arm", "type": "nominal", "scale": { "domain": ["checklist", "control"], "range": ["#0b6e4f", "#b9b9b9"] }, "legend": null } }
    },
    {
      "mark": { "type": "text", "align": "left", "dx": 6, "fontSize": 14, "color": "#1c1c1c" },
      "encoding": { "text": { "field": "retained_7d_rate", "type": "quantitative", "format": ".1%" } }
    }
  ]
}
