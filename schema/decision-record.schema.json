{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftergrid.dev/schema/decision-record/0.1.0",
  "title": "aftergrid Decision record",
  "description": "One entry in an Instance's Decision log, written by `aftergrid decide`. Cites an exact Finding revision and the Claim ids it rests on. Merging a Finding never creates one. v0 validates shape and references; the Revisit evaluator is v0.1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "owner",
    "decided_on",
    "finding",
    "rests_on_claims",
    "action",
    "rationale",
    "revisit_when",
    "outcome"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^dec_[a-z0-9]{12}$",
      "description": "Stable record id supplied by the caller so retries are idempotent."
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "description": "The person who decided. Never an agent."
    },
    "decided_on": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "content_digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^fnd_[a-z0-9]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "content_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "const": "sha256"
            },
            "value": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "description": "Digest of the cited revision at decision time, so a later content change is detectable."
        }
      }
    },
    "rests_on_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "description"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "action",
            "deliberate_inaction"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "revisit_when": {
      "type": "object",
      "additionalProperties": false,
      "description": "Structured revisit condition: a schedule, a falsifier reference, or both.",
      "properties": {
        "schedule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "timezone"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "on_date",
                "every"
              ]
            },
            "date": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "every_days": {
              "type": "integer",
              "minimum": 1
            },
            "timezone": {
              "type": "string",
              "minLength": 1,
              "description": "IANA timezone the schedule is evaluated in, e.g. America/New_York. Explicit so a date means one instant."
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "on_date"
                  }
                }
              },
              "then": {
                "required": [
                  "date"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "every"
                  }
                }
              },
              "then": {
                "required": [
                  "every_days"
                ]
              }
            }
          ]
        },
        "falsifier": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "finding_id",
            "check_id"
          ],
          "properties": {
            "finding_id": {
              "type": "string",
              "pattern": "^fnd_[a-z0-9]{12}$"
            },
            "check_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "description": "Revision whose Check is meant; defaults to the cited finding.revision."
            }
          },
          "description": "Reference to the Question falsifier Check of a Finding revision; the Revisit re-runs it and reports its outcome. Must resolve to an existing checks[] entry of kind falsifier."
        }
      },
      "anyOf": [
        {
          "required": [
            "schedule"
          ]
        },
        {
          "required": [
            "falsifier"
          ]
        }
      ]
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "recorded"
          ]
        },
        "description": {
          "type": "string"
        },
        "recorded_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "recorded"
              }
            }
          },
          "then": {
            "required": [
              "description",
              "recorded_on"
            ]
          }
        }
      ]
    },
    "supersedes": {
      "type": "string",
      "pattern": "^dec_[a-z0-9]{12}$",
      "description": "Set on a correcting record. The superseded record is never edited."
    },
    "recorded_at": {
      "type": "string",
      "description": "Timestamp written by `aftergrid decide`."
    }
  }
}
